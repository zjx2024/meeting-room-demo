# Python 虚拟环境与缓存
/.venv*/
__pycache__/
.pytest_cache/
*.py[cod]

# 本机环境配置（示例配置保留）
.env
.env.*
!.env.example
!.env.*.example

# 本地数据库与 SQLite 临时文件
/instance/
*.sqlite3
*.sqlite3-*

# 前端依赖与构建产物
/frontend/node_modules/
/frontend/dist/

# 自动验收产物与运行日志
/test-results/
*.log
*.log.*

# Windows/macOS 和 Word 临时文件
.DS_Store
Thumbs.db
desktop.ini
~$*.docx
